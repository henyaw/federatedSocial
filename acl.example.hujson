// federated-social Tailscale ACL
// ----------------------------------------------------------------------------
// Paste this into the Tailscale admin console under Access Controls.
// Adjust if you are not running every app — leave a tag in tagOwners but
// remove its entry from the DB-access rule's `src` list, and the OAuth
// client will simply never use it.
//
// Convention: tag:<app>-<role> for app tiers, tag:db-<engine> for shared
// services. autogroup:admin owns every tag (no humans authenticated as
// device-owner; the OAuth client tags devices on creation).
{
  "tagOwners": {
    // Shared infrastructure
    "tag:db-postgres":          ["autogroup:admin"],
    "tag:db-redis":             ["autogroup:admin"],

    // Pixelfed
    "tag:pixelfed-web":         ["autogroup:admin"],
    "tag:pixelfed-worker":      ["autogroup:admin"],

    // Mastodon
    "tag:mastodon-web":         ["autogroup:admin"],
    "tag:mastodon-streaming":   ["autogroup:admin"],
    "tag:mastodon-sidekiq":     ["autogroup:admin"],

    // Diaspora (single embedded container — sidekiq runs in-process)
    "tag:diaspora-web":         ["autogroup:admin"],

    // Future stacks — uncomment when you bring them up
    // "tag:funkwhale-web":     ["autogroup:admin"],
    // "tag:funkwhale-worker":  ["autogroup:admin"],
    // "tag:bluesky-pds":       ["autogroup:admin"],
  },

  "acls": [
    // App tiers may reach the shared databases on their service ports only.
    // Add new app tags to this src list when you bring them up.
    {
      "action": "accept",
      "src": [
        "tag:pixelfed-web", "tag:pixelfed-worker",
        "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
        "tag:diaspora-web",
        // "tag:funkwhale-web", "tag:funkwhale-worker",
        // "tag:bluesky-pds",
      ],
      "dst": ["tag:db-postgres:5432", "tag:db-redis:6379"],
    },

    // Admins (you, on your laptop) reach everything for debugging.
    {
      "action": "accept",
      "src": ["autogroup:admin"],
      "dst": ["*:*"],
    },
  ],

  // Optional: SSH access from admins to any tagged node, for break-glass.
  // The Tailscale sidecars in this repo do not run sshd by default, so this
  // only matters if you exec a shell inside one. Leave commented unless you
  // know you need it.
  // "ssh": [
  //   {
  //     "action": "accept",
  //     "src":    ["autogroup:admin"],
  //     "dst":    ["tag:db-postgres", "tag:db-redis",
  //                "tag:pixelfed-web", "tag:pixelfed-worker",
  //                "tag:mastodon-web", "tag:mastodon-streaming", "tag:mastodon-sidekiq",
  //                "tag:diaspora-web"],
  //     "users":  ["root", "autogroup:nonroot"],
  //   },
  // ],
}
